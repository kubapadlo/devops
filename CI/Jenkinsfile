pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'PROVISION_INFRA',
            defaultValue: true,
            description: 'Czy uruchomić Terraform (provisioning VM)?'
        )
        booleanParam(
            name: 'PUSH_IMAGE',
            defaultValue: false,
            description: 'Czy wypchnąć obraz do Docker Hub?'
        )
        booleanParam(
            name: 'RUN_DEPLOY',
            defaultValue: true,
            description: 'Czy uruchomić deploy przez Ansible?'
        )
    }

    environment {
        IMAGE_NAME     = "kanye-counter"
        REGISTRY_USER  = "jpadlo"
        REGISTRY_IMAGE = "${REGISTRY_USER}/${IMAGE_NAME}"
        VERSION        = "1.0.${BUILD_NUMBER}"
        TERRAFORM_DIR  = "infrastructure/terraform"
        ANSIBLE_DIR    = "infrastructure/ansible"
    }

    stages {
        stage('Clone') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                script {
                    sh "docker build --target builder -t ${IMAGE_NAME}-test ."
                    sh "docker run --rm ${IMAGE_NAME}-test pnpm test"
                }
            }
            post {
                always {
                    sh "docker rmi ${IMAGE_NAME}-test || true"
                }
            }
        }

        stage('Build') {
            steps {
                sh """
                    docker build \
                        --build-arg GIT_COMMIT=\$(git rev-parse --short HEAD) \
                        --build-arg BUILD_NUMBER=${BUILD_NUMBER} \
                        --build-arg BUILD_DATE=\$(date -u +%Y-%m-%dT%H:%M:%SZ) \
                        -t ${IMAGE_NAME}:${VERSION} \
                        -t ${IMAGE_NAME}:latest .
                """
                sh "docker tag ${IMAGE_NAME}:${VERSION} ${REGISTRY_IMAGE}:${VERSION}"
                sh "docker tag ${IMAGE_NAME}:latest ${REGISTRY_IMAGE}:latest"
            }
        }

        stage('Publish') {
            when { expression { return params.PUSH_IMAGE } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    sh "docker push ${REGISTRY_IMAGE}:${VERSION}"
                    sh "docker push ${REGISTRY_IMAGE}:latest"
                }
            }
            post {
                always {
                    sh "docker logout || true"
                }
            }
        }

        stage('Terraform') {
            when { expression { return params.PROVISION_INFRA } }
            steps {
                withCredentials([
                    string(credentialsId: 'proxmox-api-token',     variable: 'PROXMOX_TOKEN'),
                    string(credentialsId: 'proxmox-root-password',  variable: 'PROXMOX_PASS'),
                    sshUserPrivateKey(credentialsId: 'ansible-ssh-key', keyFileVariable: 'SSH_KEY')
                ]) {
                    dir("${TERRAFORM_DIR}") {
                        sh "terraform init"
                        sh "terraform apply -auto-approve -var='api_token=${PROXMOX_TOKEN}' -var='root_password=${PROXMOX_PASS}'"
                        
                        script {
                            def vmIp = ""
                            timeout(time: 5, unit: 'MINUTES') {
                                waitUntil {
                                    vmIp = sh(script: "terraform output -raw vm_ip", returnStdout: true).trim()
                                    return (vmIp != "" && !vmIp.contains("Warning") && vmIp != "127.0.0.1")
                                }
                            }
                            
                            writeFile(file: "${WORKSPACE}/vm_ip.txt", text: vmIp) 
                        }
                    } 
                } 
            } 
        }

        stage('Deploy') {
            when { expression { return params.RUN_DEPLOY } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'ansible-ssh-key', keyFileVariable: 'SSH_KEY'),
                    string(credentialsId: 'duckdns-token', variable: 'DUCKDNS_TOKEN')
                ]) {
                    script {
                        def targetIp = ""
                            if (fileExists("${WORKSPACE}/vm_ip.txt")) {
                                targetIp = readFile("${WORKSPACE}/vm_ip.txt").trim()
                            } else {
                                error "Nie odnaleziono pliku ${WORKSPACE}/vm_ip.txt! Czy Terraform zadziałał poprawnie?"
                            }

                        writeFile(
                            file: "${ANSIBLE_DIR}/inventory/hosts.ini",
                            text: "[Endpoints]\n${targetIp} ansible_user=ubuntu ansible_ssh_private_key_file=${SSH_KEY}\n"
                        )

                        sh """
                            ansible-playbook ${ANSIBLE_DIR}/playbook.yml \
                                --private-key=${SSH_KEY} \
                                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                                --extra-vars "image_name=${REGISTRY_IMAGE} duckdns_token=${DUCKDNS_TOKEN}"
                        """
                    }
                }
            }
        }
    } 

    post {
        always {
            script {
                archiveArtifacts artifacts: "infrastructure/terraform/vm_ip.txt, *.json", allowEmptyArchive: true
                sh "docker rmi ${IMAGE_NAME}:${VERSION} ${IMAGE_NAME}:latest || true"
                sh "docker rmi ${REGISTRY_IMAGE}:${VERSION} ${REGISTRY_IMAGE}:latest || true"
            }
        }
    }
}
pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'PROVISION_INFRA',
            defaultValue: false,
            description: 'Czy uruchomić Terraform (provisioning VM na Proxmox)?'
        )
        booleanParam(
            name: 'RUN_DEPLOY',
            defaultValue: true,
            description: 'Czy uruchomić deploy przez Ansible?'
        )
    }

    environment {
        IMAGE_NAME     = "kanye-counter"
        REGISTRY_USER  = "jpadlo"
        REGISTRY_IMAGE = "${REGISTRY_USER}/${IMAGE_NAME}"
        VERSION        = "1.0.${BUILD_NUMBER}"

        TERRAFORM_DIR  = "infrastructure/terraform"
        ANSIBLE_DIR    = "infrastructure/ansible"
    }

    stages {

        stage('Clone') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                script {
                    sh """
                        docker build \
                            --target builder \
                            -t ${IMAGE_NAME}-test .
                    """
                    sh "docker run --rm ${IMAGE_NAME}-test pnpm test"
                }
            }
            post {
                always {
                    sh "docker rmi ${IMAGE_NAME}-test || true"
                }
            }
        }

        stage('Build') {
            steps {
                sh """
                    docker build \
                        --build-arg GIT_COMMIT=\$(git rev-parse --short HEAD) \
                        --build-arg BUILD_NUMBER=${BUILD_NUMBER} \
                        --build-arg BUILD_DATE=\$(date -u +%Y-%m-%dT%H:%M:%SZ) \
                        -t ${IMAGE_NAME}:${VERSION} \
                        -t ${IMAGE_NAME}:latest .
                """
            }
        }

        stage('Publish') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    sh "docker tag ${IMAGE_NAME}:${VERSION} ${REGISTRY_IMAGE}:${VERSION}"
                    sh "docker tag ${IMAGE_NAME}:latest     ${REGISTRY_IMAGE}:latest"
                    sh "docker push ${REGISTRY_IMAGE}:${VERSION}"
                    sh "docker push ${REGISTRY_IMAGE}:latest"
                }
            }
            post {
                always {
                    sh "docker logout || true"
                }
            }
        }

        // ──────────────────────────────────────────
        // TERRAFORM — zapisuje IP do zmiennej środowiskowej
        // ──────────────────────────────────────────
        stage('Terraform') {
            when {
                expression { return params.PROVISION_INFRA }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'proxmox-api-token',     variable: 'PROXMOX_TOKEN'),
                    string(credentialsId: 'proxmox-root-password',  variable: 'PROXMOX_PASS')
                ]) {
                    dir("${TERRAFORM_DIR}") {
                        sh "terraform init"
                        sh """
                            terraform apply -auto-approve \
                                -var="api_token=${PROXMOX_TOKEN}" \
                                -var="root_password=${PROXMOX_PASS}"
                        """
                    }
                }

                        script {
                            // Pobierz IP z terraform output i zapisz do pliku
                            def vmIp = sh(
                                script: "terraform output -raw vm_ip",
                                returnStdout: true
                            ).trim()

                            echo "VM IP z Terraform: ${vmIp}"

                            // Wygeneruj plik inventory dla Ansible
                            writeFile(
                                file: "../../${ANSIBLE_DIR}/inventory/hosts.ini",
                                text: """\
[Endpoints]
${vmIp} ansible_user=ubuntu ansible_ssh_private_key_file=${SSH_KEY}

[Endpoints:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
"""
                            )

                            // Zapisz IP jako artifact do reużycia w Deploy
                            // gdy Terraform nie jest uruchamiany ponownie
                            writeFile(
                                file: "vm_ip.txt",
                                text: vmIp
                            )
                        }
                    }
                }
            }
        }

        // ──────────────────────────────────────────
        // ANSIBLE — używa IP z Terraform lub z pliku
        // ──────────────────────────────────────────
        stage('Deploy') {
            when {
                expression { return params.RUN_DEPLOY }
            }
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ansible-ssh-key',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    script {
                        // Jeśli Terraform nie był uruchomiony w tym buildzie,
                        // spróbuj wczytać IP z poprzedniego runu
                        if (!params.PROVISION_INFRA) {
                            def savedIp = sh(
                                script: """
                                    terraform -chdir=${TERRAFORM_DIR} output -raw vm_ip 2>/dev/null || \
                                    cat vm_ip.txt 2>/dev/null || \
                                    echo ''
                                """,
                                returnStdout: true
                            ).trim()

                            if (!savedIp) {
                                error("Brak IP maszyny. Uruchom pipeline z PROVISION_INFRA=true.")
                            }

                            echo "Używam zapisanego IP: ${savedIp}"

                            writeFile(
                                file: "${ANSIBLE_DIR}/inventory/hosts.ini",
                                text: """\
[Endpoints]
${savedIp} ansible_user=ubuntu ansible_ssh_private_key_file=${SSH_KEY}

[Endpoints:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
"""
                            )
                        }

                        // Poczekaj aż VM będzie dostępna przez SSH
                        sh """
                            echo "Czekam na SSH na maszynie..."
                            timeout 120 bash -c '
                                until ansible Endpoints \
                                    -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                                    --private-key=${SSH_KEY} \
                                    -m ping 2>/dev/null; do
                                    sleep 5
                                done
                            '
                        """

                        sh """
                            ansible-playbook ${ANSIBLE_DIR}/playbook.yml \
                                --private-key=${SSH_KEY} \
                                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                                --extra-vars "image_name=${REGISTRY_IMAGE} image_tag=${VERSION}"
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh "docker inspect ${IMAGE_NAME}:${VERSION} > docker-inspect-${VERSION}.json || true"
                archiveArtifacts artifacts: "docker-inspect-${VERSION}.json, vm_ip.txt",
                                 allowEmptyArchive: true

                sh "docker rmi ${IMAGE_NAME}:${VERSION}     || true"
                sh "docker rmi ${IMAGE_NAME}:latest         || true"
                sh "docker rmi ${REGISTRY_IMAGE}:${VERSION} || true"
            }
        }
    }
}